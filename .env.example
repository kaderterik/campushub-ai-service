PORT=8005
HOST=0.0.0.0
APP_ENV=development
# fake (varsayilan) veya real (gercek mDeBERTa modeli).
# Not: docker compose bu dosyayi okumaz ve varsayilan olarak real calisir (demo komutu).
# Dikkat: bu dosya .env adiyla kopyalanirsa compose .env'yi okur ve buradaki deger gecerli olur.
# docker run --env-file ile gercek model icin: -e CLASSIFIER_BACKEND=real ekleyin.
CLASSIFIER_BACKEND=fake
